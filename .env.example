# VIN decoding goes through the vindecoder.eu VIN Decoder API, run by Vincario.
# Request a free trial (API key + secret key) at https://vincario.com
#
# Spring Boot reads these as automotive.vehicleTracker.services.providers.vinDecoderProvider.*
# All three are required at startup. Copy this file to .env, fill it in, then:
#   set -a; source .env; set +a; ./gradlew bootRun

# Your vindecoder.eu API key (it goes in the request URL)
AUTOMOTIVE_VEHICLETRACKER_SERVICES_PROVIDERS_VINDECODERPROVIDER_APIKEY=your-api-key

# Your vindecoder.eu secret key (only used to sign requests: the SHA-1 control sum)
AUTOMOTIVE_VEHICLETRACKER_SERVICES_PROVIDERS_VINDECODERPROVIDER_SECRETKEY=your-secret-key

# The API prefix, version included
AUTOMOTIVE_VEHICLETRACKER_SERVICES_PROVIDERS_VINDECODERPROVIDER_BASEURL=https://api.vindecoder.eu/3.2
